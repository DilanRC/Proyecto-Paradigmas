{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "*": false,
      "dev": true,
      "main": true
    }
  },
  "services": {
    "app": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "ignoreCommand": "bash Tools/vercel-ignore-build.sh"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
