{
  "openapi": "3.1.0",
  "info": {
    "title": "TinderCows Supabase Auth",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": { "description": "Service configured" },
          "503": { "description": "Required environment is missing" }
        }
      }
    },
    "/v1/auth/verify": {
      "get": {
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Verified Supabase user identity" },
          "401": { "description": "Missing or invalid JWT" },
          "403": { "description": "Valid token without the required provider authorization" },
          "503": { "description": "Required environment is missing" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
