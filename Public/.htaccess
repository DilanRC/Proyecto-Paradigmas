# La carpeta del proyecto puede vivir entera dentro de htdocs: su .htaccess raíz
# niega todo y solo esta carpeta se publica.
Require all granted
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

DirectoryIndex index.php
Options -Indexes

# Señal para PHP de que Apache sí aplica este archivo (AllowOverride).
<IfModule mod_env.c>
    SetEnv TC_HTACCESS 1
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Apache puede ocultar Authorization antes de entregarlo a PHP. El backend
# resuelve la Persona únicamente desde este Bearer verificado. TC_REWRITE le
# confirma a PHP que mod_rewrite funciona; sin él la aplicación se rechaza.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization},E=TC_REWRITE:1]

# TC_BASE = URL de esta carpeta ("/" con VirtualHost, "/GanadoCerca/Public/"
# dentro de htdocs). Las redirecciones la usan para no salir del proyecto.
RewriteCond $0#%{REQUEST_URI} ^([^#]*)#(.*)\1$
RewriteRule ^.*$ - [E=TC_BASE:%2]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
# La URL pública no expone los wrappers PHP. Estas redirecciones solo se
# activan cuando la persona pidió directamente el legado; las reescrituras
# internas de abajo no vuelven a dispararlas.
RewriteCond %{THE_REQUEST} \s[^?\s]*/registro\.php(?:[?\s]) [NC]
RewriteCond %{QUERY_STRING} (^|&)capacidad=comprador(&|$) [NC]
RewriteRule ^registro\.php$ %{ENV:TC_BASE}registro/comprador [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/registro\.php(?:[?\s]) [NC]
RewriteCond %{QUERY_STRING} (^|&)capacidad=productor(&|$) [NC]
RewriteRule ^registro\.php$ %{ENV:TC_BASE}registro/productor [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/registro\.php(?:[?\s]) [NC]
RewriteCond %{QUERY_STRING} (^|&)capacidad=transportista(&|$) [NC]
RewriteRule ^registro\.php$ %{ENV:TC_BASE}registro/transportista [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/registro\.php(?:[?\s]) [NC]
RewriteRule ^registro\.php$ %{ENV:TC_BASE}registro [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/login\.php(?:[?\s]) [NC]
RewriteCond %{QUERY_STRING} (^|&)area=admin(&|$) [NC]
RewriteRule ^login\.php$ %{ENV:TC_BASE}admin/entrar [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/login\.php(?:[?\s]) [NC]
RewriteRule ^login\.php$ %{ENV:TC_BASE}entrar [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ %{ENV:TC_BASE} [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/explorar\.php(?:[?\s]) [NC]
RewriteRule ^explorar\.php$ %{ENV:TC_BASE}explorar [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/fletes\.php(?:[?\s]) [NC]
RewriteRule ^fletes\.php$ %{ENV:TC_BASE}fletes [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/mi-actividad\.php(?:[?\s]) [NC]
RewriteRule ^mi-actividad\.php$ %{ENV:TC_BASE}mi-actividad [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/ajustes\.php(?:[?\s]) [NC]
RewriteRule ^ajustes\.php$ %{ENV:TC_BASE}ajustes [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/publicar\.php(?:[?\s]) [NC]
RewriteRule ^publicar\.php$ %{ENV:TC_BASE}publicar [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/sobre-nosotros\.php(?:[?\s]) [NC]
RewriteRule ^sobre-nosotros\.php$ %{ENV:TC_BASE}sobre-nosotros [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/como-usar\.php(?:[?\s]) [NC]
RewriteRule ^como-usar\.php$ %{ENV:TC_BASE}como-usar [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/privacidad\.php(?:[?\s]) [NC]
RewriteRule ^privacidad\.php$ %{ENV:TC_BASE}privacidad [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/terminos\.php(?:[?\s]) [NC]
RewriteRule ^terminos\.php$ %{ENV:TC_BASE}terminos [R=301,L,NE,QSD]
RewriteCond %{THE_REQUEST} \s[^?\s]*/legal\.php(?:[?\s]) [NC]
RewriteRule ^legal\.php$ %{ENV:TC_BASE}legal [R=301,L,NE,QSD]

# Superficie pública.
RewriteRule ^$ index.php [END]
RewriteRule ^explorar/?$ explorar.php [END]
RewriteRule ^entrar/?$ login.php [END]
RewriteRule ^registro/?$ registro.php [END]
RewriteRule ^registro/(comprador|productor|transportista)/?$ registro.php?capacidad=$1 [END,QSA]
RewriteRule ^fletes/?$ fletes.php [END]
RewriteRule ^mi-actividad/?$ mi-actividad.php [END]
RewriteRule ^ajustes/?$ ajustes.php [END]
RewriteRule ^participar/?$ participar.php [END]
RewriteRule ^me-interesa/?$ me-interesa.php [END]
RewriteRule ^subastas/?$ subastas.php [END]
RewriteRule ^publicar/?$ publicar.php [END]
RewriteRule ^sobre-nosotros/?$ sobre-nosotros.php [END]
RewriteRule ^como-usar/?$ como-usar.php [END]
RewriteRule ^privacidad/?$ privacidad.php [END]
RewriteRule ^terminos/?$ terminos.php [END]
RewriteRule ^legal/?$ legal.php [END]

# Superficie administrativa. El panel sigue siendo PHP internamente, pero
# nunca se presenta como tal al navegador.
RewriteRule ^admin/entrar/?$ login.php?area=admin [END,QSA]
RewriteRule ^admin/dashboard/?$ dashboard.php [END]
RewriteRule ^admin/productores/?$ productores.php [END]
RewriteRule ^admin/compradores/?$ compradores.php [END]
RewriteRule ^admin/transportistas/?$ transportistas.php [END]
RewriteRule ^admin/vehiculos/?$ vehiculos.php [END]
RewriteRule ^admin/metodos-pago/?$ pagometodos.php [END]
RewriteRule ^admin/publicaciones/?$ publicaciones.php [END]
RewriteRule ^admin/administradores/?$ administradores.php [END]
RewriteRule ^admin/catalogos/?$ catalogos.php [END]
RewriteRule ^admin/bitacora/?$ bitacora.php [END]
RewriteRule ^admin/fletes/?$ adminfletes.php [END]
RewriteRule ^admin/documentos/?$ documentos.php [END]
RewriteRule ^admin/subastas/?$ adminsubastas.php [END]

# API versionada. Los nombres de tablas y archivos son implementación; el
# contrato público usa recursos semánticos y no filtra extensiones PHP.
RewriteRule ^api/v1/auth/config/?$ api/auth-config.php [END]
RewriteRule ^api/v1/admin/status/?$ api/admin-status.php [END]
RewriteRule ^api/v1/admin/publicaciones/?$ api/admin-publicaciones.php [END]
RewriteRule ^api/v1/admin/administradores/?$ api/admin-administradores.php [END]
RewriteRule ^api/v1/admin/catalogos/?$ api/admin-catalogos.php [END]
RewriteRule ^api/v1/admin/bitacora/?$ api/admin-bitacora.php [END]
RewriteRule ^api/v1/admin/documentos/?$ api/admin-documentos.php [END]
RewriteRule ^api/v1/admin/subastas/?$ api/admin-subastas.php [END]
RewriteRule ^api/v1/actividad/?$ api/mi-actividad.php [END]
RewriteRule ^api/v1/mi-vehiculos/?$ api/mi-vehiculos.php [END]
RewriteRule ^api/v1/mi-fincas/?$ api/mi-fincas.php [END]
RewriteRule ^api/v1/mi-ofertas/?$ api/mi-ofertas.php [END]
RewriteRule ^api/v1/fletes/?$ api/fletes.php [END]
RewriteRule ^api/v1/subastas/?$ api/subastas.php [END]
RewriteRule ^api/v1/notificaciones/?$ api/notificaciones.php [END]
RewriteRule ^api/v1/solicitudes-compra/?$ api/solicitudes-compra.php [END]
RewriteRule ^api/v1/admin/fletes/?$ api/admin-fletes.php [END]
RewriteRule ^api/v1/pago-metodos-disponibles/?$ api/pago-metodos-disponibles.php [END]
RewriteRule ^api/v1/mi-perfil/?$ api/mi-perfil.php [END]
RewriteRule ^api/v1/identidad/?$ api/identidad.php [END]
RewriteRule ^api/v1/registro/identificacion/?$ api/registro-validar-identificacion.php [END]
RewriteRule ^api/v1/registro/?$ api/registro.php [END]
RewriteRule ^api/v1/capacidades/?$ api/capacidades.php [END]
RewriteRule ^api/v1/publicaciones/?$ api/publicaciones.php [END]
RewriteRule ^api/v1/publicaciones/interacciones/?$ api/publicacion-interacciones.php [END]
RewriteRule ^api/v1/catalogos/?$ api/catalogos.php [END]
RewriteRule ^api/v1/mi-animales/vacunas/?$ api/mi-animales-vacunas.php [END]
RewriteRule ^api/v1/mi-animales/?$ api/mi-animales.php [END]
RewriteRule ^api/v1/productores/?$ api/productores.php [END]
RewriteRule ^api/v1/productores/direccion/?$ api/productores-direccion.php [END]
RewriteRule ^api/v1/productores/ubicacion/?$ api/productores-ubicacion.php [END]
RewriteRule ^api/v1/compradores/?$ api/compradores.php [END]
RewriteRule ^api/v1/transportistas/?$ api/transportistas.php [END]
RewriteRule ^api/v1/transportistas/vehiculos/?$ api/transportistas-vehiculos.php [END]
RewriteRule ^api/v1/vehiculos/?$ api/vehiculos.php [END]
RewriteRule ^api/v1/metodos-pago/?$ api/pagometodos.php [END]
RewriteRule ^api/v1/fincas/direccion/?$ api/fincas-direccion.php [END]

# Compatibilidad: los clientes y pruebas antiguas que aún llaman /api/*.php
# siguen funcionando durante la migración, pero la interfaz ya no los genera.
</IfModule>
